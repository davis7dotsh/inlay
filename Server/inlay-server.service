[Unit]
Description=Inlay dictation server
After=network-online.target
Wants=network-online.target

[Service]
User=inlay
Group=inlay
ExecStart=/opt/inlay/inlay-server
Environment=INLAY_SERVER_HOST=0.0.0.0
Environment=INLAY_SERVER_PORT=8391
Environment=INLAY_SERVER_DATA_DIR=/var/lib/inlay
Environment=INLAY_SERVER_TOKEN_FILE=/etc/inlay/token
Environment=INLAY_ENGINE_PATH=/opt/inlay/helpers/inlay-engine
Environment=INLAY_TEXT_ENGINE_PATH=/opt/inlay/helpers/inlay-text-engine
Environment=INLAY_VAD_PATH=/opt/inlay/resources/silero-vad.bin
Environment=INLAY_SPEECH_MODEL=/var/lib/inlay/models/ggml-parakeet-tdt-0.6b-v3-f16.bin
Environment=INLAY_TEXT_MODEL=/var/lib/inlay/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/inlay
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
