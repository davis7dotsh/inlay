<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Transcriber Hub on services-01, a LaunchDaemon run by services-admin from boot, kept alive.
  TCC denies a LaunchDaemon access to network volumes, so hub-job runs the hub over an ssh hop to
  127.0.0.1, whose forced command is hub-run (it mounts the share and starts the hub).
  install-daemon.sh copies this file to /Library/LaunchDaemons.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.codecaine.transcriber-hub</string>
  <key>UserName</key>
  <string>services-admin</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>InitGroups</key>
  <true/>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/usr/local/libexec/transcriber-hub/hub-job</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/services-admin</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>20</integer>
  <key>StandardOutPath</key>
  <string>/Users/services-admin/transcriber-hub-logs/hub.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/services-admin/transcriber-hub-logs/hub.err.log</string>
</dict>
</plist>
